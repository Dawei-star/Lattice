# 后端服务配置示例 —— 复制为 .env 后按需修改
# 真实 .env 已被 .gitignore 忽略，切勿提交真实密钥

NODE_ENV=development

# HTTP 服务监听地址
HOST=127.0.0.1
PORT=5177

# SQLite 数据库文件路径（相对路径以 server/ 目录为基准）
DB_FILE=./data/lattice.db

# 允许跨域的前端来源，多个用英文逗号分隔；生产环境禁止使用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 是否在启动时自动执行未应用的数据库迁移
AUTO_MIGRATE=true

# 附件（图片/文件）落盘目录；留空则默认数据库同级的 data/attachments
# ATTACHMENTS_DIR=

# 单个附件上传体积上限（MB），base64 传输，默认 15
MAX_UPLOAD_MB=15

# 前端构建产物目录（仅在需要覆盖默认的 ../web/dist 时设置，桌面端打包后使用）
# WEB_DIST_DIR=

# 静态站点导出落盘根目录；留空则默认数据库同级的 data/export
# 每次导出在其下建一个 site-<时间戳> 子目录，整体拷走即可发布
# EXPORT_DIR=

# 版本历史快照的最小时间间隔（分钟）。间隔内的连续自动保存被节流，不重复留快照；
# 设为 0 表示每次实质改动都存一条。默认 5
VERSION_INTERVAL_MINUTES=5

# 每篇笔记保留的历史版本条数上限，超出即淘汰最旧的。默认 50
VERSION_RETENTION=50
