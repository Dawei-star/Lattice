# 后端服务配置示例 —— 复制为 .env 后按需修改
# 真实 .env 已被 .gitignore 忽略，切勿提交真实密钥

NODE_ENV=development

# HTTP 服务监听地址
HOST=127.0.0.1
PORT=5177

# SQLite 数据库文件路径（相对路径以 server/ 目录为基准）
DB_FILE=./data/lattice.db

# 允许跨域的前端来源，多个用英文逗号分隔；生产环境禁止使用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 是否在启动时自动执行未应用的数据库迁移
AUTO_MIGRATE=true

# 可选：设置后 /api/ai 要求 Authorization: Bearer <token>
# AI_ACCESS_TOKEN=
# 认证成功后由服务端固定角色，不接受客户端伪造；viewer | editor | admin
AI_ACCESS_ROLE=editor

# 前端构建产物目录（仅在需要覆盖默认的 ../web/dist 时设置，桌面端打包后使用）
# WEB_DIST_DIR=
