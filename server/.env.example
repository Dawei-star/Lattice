# 后端服务配置示例 —— 复制为 .env 后按需修改
# 真实 .env 已被 .gitignore 忽略，切勿提交真实密钥

NODE_ENV=development

# HTTP 服务监听地址
HOST=127.0.0.1
PORT=5177

# SQLite 数据库文件路径（相对路径以 server/ 目录为基准）
DB_FILE=./data/lattice.db

# 允许跨域的前端来源，多个用英文逗号分隔；生产环境禁止使用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 是否在启动时自动执行未应用的数据库迁移
AUTO_MIGRATE=true

# 非回环监听时必填；设置后所有 /api 要求 X-Workspace-Token，Bearer 作为 CLI 兼容回退
# WORKSPACE_ACCESS_TOKEN=
# 工作区令牌认证后的服务端角色：viewer | editor | admin
WORKSPACE_ACCESS_ROLE=editor

# 可选：在工作区认证之外，设置后 /api/ai 还要求 Authorization: Bearer <token>
# AI_ACCESS_TOKEN=
# 认证成功后由服务端固定角色，不接受客户端伪造；viewer | editor | admin
AI_ACCESS_ROLE=editor

# MCP stdio 默认只读；仅在明确需要外部 Agent 写入 Vault 时开启
LATTICE_MCP_ALLOW_WRITES=false

# 可选：独立服务部署时为 ai_settings 提供 32 字节 hex/base64 密钥；桌面版由 Windows safeStorage 自动管理
# AI_SETTINGS_ENCRYPTION_KEY=

# 可选：每天在本地时区的这个小时自动生成 Journal/每日摘要 YYYY-MM-DD.md；留空则只手动生成
# AI_DIGEST_HOUR=

# 前端构建产物目录（仅在需要覆盖默认的 ../web/dist 时设置，桌面端打包后使用）
# WEB_DIST_DIR=
