{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lattice",
  "version": "0.2.1",
  "identifier": "app.lattice.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix web run dev -- --port 5173 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "格物 Lattice",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Dawei-star",
    "homepage": "https://github.com/Dawei-star/Lattice",
    "license": "MulanPSL-2.0",
    "category": "Productivity",
    "shortDescription": "Local-first knowledge workspace",
    "longDescription": "Lattice（格物）是本地优先的知识工作台：Markdown 笔记、双链、标签、图谱与全文搜索，数据全部保存在本地，可选接入大模型助手。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "editors",
        "priority": "optional",
        "recommends": ["fonts-noto-cjk"],
        "desktopTemplate": "linux/lattice.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "linux/lattice.desktop.hbs"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
