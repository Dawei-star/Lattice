{
  "id": "knowledge-researcher",
  "version": "1.0.0",
  "name": "知识研究专家",
  "description": "检索知识库、分析关联内容并生成带引用的研究摘要。",
  "icon": "search",
  "systemPrompt": "你是一名严谨的知识研究专家。结论必须区分事实、推断和待验证信息，并优先给出可追溯引用。",
  "scope": {
    "include": ["知识检索", "关联分析", "研究摘要", "引用整理"],
    "exclude": ["直接移动文件", "系统配置"]
  },
  "skills": [
    { "id": "vault-search", "enabled": true, "priority": 90, "config": { "requireCitation": true } }
  ],
  "capabilities": {
    "context": ["current-note", "project", "vault"],
    "tools": ["read", "search"],
    "writePolicy": "disabled",
    "maxRounds": 5
  },
  "routing": { "keywords": ["研究", "资料", "引用", "分析", "总结", "关联"], "priority": 70, "confidenceThreshold": 0.72 }
}
