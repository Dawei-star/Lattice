{
  "name": "lattice",
  "version": "0.2.0",
  "private": true,
  "description": "格物 Lattice —— 本地优先的双链笔记知识库（类 Obsidian 全栈实现）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "setup": "npm --prefix web install && npm --prefix scripts/notion-calendar-mcp install",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --prefix web run dev",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "test:desktop": "cargo test --manifest-path src-tauri/Cargo.toml --release",
    "build": "npm --prefix web run build",
    "ai": "node scripts/lattice-ai.mjs",
    "fc": "node scripts/fc.mjs",
    "test:fc": "node --test scripts/fc.test.mjs",
    "test:fc:cli": "node scripts/fc-cli-smoke.mjs",
    "test:web": "npm --prefix web run test",
    "p2:roundtrip": "node scripts/p2-roundtrip-scan.mjs",
    "eval:golden:compare": "node src-tauri/eval/golden-regression.mjs",
    "eval:quality-gate": "node src-tauri/eval/quality-gate.mjs",
    "verify:fixtures": "node src-tauri/tests/tools/validate-fixtures.mjs",
    "test": "npm --prefix web run test",
    "verify": "npm run test:fc && npm --prefix web run typecheck && npm --prefix web run test && npm run verify:fixtures && npm run test:desktop"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2"
  }
}
