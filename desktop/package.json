{
  "name": "lattice-desktop",
  "productName": "格物 Lattice",
  "version": "0.1.1",
  "private": true,
  "description": "格物 Lattice —— 本地优先的双链笔记知识库（Windows 桌面版）",
  "author": "Lattice",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/**/*.test.js",
    "build:web": "npm --prefix ../web run build",
    "pack": "npm run build:web && electron-builder --win --dir",
    "dist": "npm run build:web && electron-builder --win",
    "dist:installer": "npm run build:web && electron-builder --win nsis",
    "dist:portable": "npm run build:web && electron-builder --win portable"
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
